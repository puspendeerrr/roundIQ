# ======================================================
# RoundIQ Backend Production Environment Configuration
# Target Platform: Render Web Service
# Database: Neon PostgreSQL
# Production Domain: https://roundiq.algorithyum.in
# ======================================================

# Server Execution Environment
NODE_ENV=production
PORT=5000

# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:password@ep-fancy-shadow-ax4d6udv-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"

# URLs & CORS Routing
FRONTEND_URL="https://roundiq.algorithyum.in"
APP_URL="https://roundiq-backend.onrender.com"

# JWT Security Secrets (Must be unique 32+ character strings)
JWT_ACCESS_SECRET="roundiq_production_jwt_access_secret_key_2026_super_secure_98765"
JWT_REFRESH_SECRET="roundiq_production_jwt_refresh_secret_key_2026_super_secure_12345"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# OAuth Authentication (Optional)
GOOGLE_CLIENT_ID=""

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID="rzp_live_key_id_here"
RAZORPAY_KEY_SECRET="rzp_live_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="rzp_live_webhook_secret_here"

# Redis Cache Cluster (Optional - Memory cache fallback enabled)
REDIS_URL="redis://red-cluster.render.com:6379"

# Transactional SMTP Mailer Configuration (Optional)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS=""
FROM_EMAIL="noreply@roundiq.com"
